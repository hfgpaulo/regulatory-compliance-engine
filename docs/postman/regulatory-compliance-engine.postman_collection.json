                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status ready\", () => pm.expect(pm.response.json().status).to.eql(\"ready\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "C01 — transferência simples, contraparte sem risco",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/evaluate",
            "description": "Guarda o id em c01Id, usado pelo P02.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": {\n    \"type\": \"personal_loan\",\n    \"origin\": \"US\",\n    \"origin_currency\": \"USD\"\n  },\n  \"operation\": {\n    \"amount\": \"1000.00\",\n    \"currency\": \"USD\",\n    \"method\": \"international_transfer\",\n    \"counterparty\": {\n      \"name\": \"John Doe\",\n      \"pep\": false\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const results = body.report.results;",
                  "const byDomain = (d, s) => results.find(r => r.domain === d && (!s || r.status === s));",
                  "pm.test(\"nao conforme (IOF sempre exige adaptacao)\", () => pm.expect(body.report.compliant).to.eql(false));",
                  "pm.test(\"rules_version presente\", () => pm.expect(body.rules_version).to.match(/^sha256:/));",
                  "pm.test(\"1 resultado(s) no relatorio\", () => pm.expect(results).to.have.lengthOf(1));",
                  "pm.test(\"IOF = 19.00\", () => pm.expect(byDomain(\"IOF\").calculated_amount).to.eql(\"19.00\"));",
                  "pm.collectionVariables.set(\"c01Id\", body.id);"
                ]
              }
            }
          ]
        },
